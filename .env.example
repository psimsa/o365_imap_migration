# Source tenant: Entra app registration using APPLICATION permissions.
# Only Mail.Read is required (see README); add Mail.ReadWrite only if you later
# extend the script to modify the source mailbox (delete/move/mark as read).
SOURCE_CLIENT_ID=
SOURCE_CLIENT_SECRET=
SOURCE_TENANT_ID=

# Copy message attachments to the target server (slower).
MIGRATE_ATTACHMENTS=true

# Body format written to the target IMAP server: html or plain.
# Graph only returns HTML bodies; "plain" strips the markup.
EMAIL_FORMAT=html

# Verify the IMAP server's TLS certificate. Keep true; false allows MITM.
IMAP_SSL_VERIFY=true

# Messages requested per Graph page (1-1000). Paging follows @odata.nextLink.
GRAPH_PAGE_SIZE=100

# Mailbox list: source_email,target_server,target_email,target_password
CSV_FILE=details.csv

# Migrate the O365 folder tree below this target mailbox folder. Missing folders
# are created (parents first). Empty = classic INBOX/Drafts/Sent/... mapping.
TARGET_PARENT_FOLDER=

# Only these source folders/paths (comma separated). A folder also selects its
# subtree. Empty = every folder.
MIGRATE_FOLDERS=

# Maximum messages per mailbox (0 = all). Newest messages first.
MIGRATE_LIMIT=0
